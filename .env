# =============================================================================
# Podman Compose environment — RHEL 8.10 streaming stack
# Custom host ports ONLY (no defaults: 2181/9092/9200/5601/8080/8083)
# =============================================================================

COMPOSE_PROJECT_NAME=streamstack

# --- Image tags ---
ZOOKEEPER_IMAGE=docker.io/confluentinc/cp-zookeeper:7.6.1
KAFKA_IMAGE=docker.io/confluentinc/cp-kafka:7.6.1
# Prefer stock Connect + host-mounted plugin (see scripts/03-fetch-opensearch-plugin.sh).
# Optional baked image: localhost/kafka-connect-opensearch:7.6.1 (./scripts/03-build-connect.sh)
CONNECT_IMAGE=docker.io/confluentinc/cp-kafka-connect:7.6.1
OPENSEARCH_IMAGE=docker.io/opensearchproject/opensearch:2.14.0
DASHBOARDS_IMAGE=docker.io/opensearchproject/opensearch-dashboards:2.14.0
KAFKA_UI_IMAGE=docker.io/provectuslabs/kafka-ui:v0.7.2
OPENSEARCH_CONNECTOR_VERSION=4.1.0

# --- Host-published ports (CRITICAL: non-default) ---
ZOOKEEPER_HOST_PORT=12181
KAFKA_HOST_PORT=19092
CONNECT_HOST_PORT=18083
OPENSEARCH_HOST_PORT=19200
OPENSEARCH_TRANSPORT_HOST_PORT=19600
KAFKA_UI_HOST_PORT=18081
DASHBOARDS_HOST_PORT=15601

# --- Internal container ports (service-to-service) ---
ZOOKEEPER_PORT=2181
KAFKA_INTERNAL_PORT=29092
KAFKA_EXTERNAL_PORT=9092
CONNECT_PORT=8083
OPENSEARCH_HTTP_PORT=9200
OPENSEARCH_TRANSPORT_PORT=9600
KAFKA_UI_PORT=8080
DASHBOARDS_PORT=5601

# --- Cluster identity ---
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_CLUSTER_NAME=local-rhel-cluster

# --- OpenSearch ---
# Demo/lab: security plugin disabled. Re-enable for production (TLS + auth).
DISABLE_SECURITY_PLUGIN=true
# Quote values with spaces so `source .env` in bash scripts is safe.
# podman-compose / dotenv strip the surrounding quotes.
OPENSEARCH_JAVA_OPTS="-Xms1g -Xmx1g"
OPENSEARCH_INITIAL_ADMIN_PASSWORD='Str0ng_OpenSearch_Admin!'

# --- Kafka Connect worker ---
CONNECT_GROUP_ID=streamstack-connect-cluster
CONNECT_CONFIG_STORAGE_TOPIC=_connect-configs
CONNECT_OFFSET_STORAGE_TOPIC=_connect-offsets
CONNECT_STATUS_STORAGE_TOPIC=_connect-status
CONNECT_CONFIG_STORAGE_REPLICATION_FACTOR=1
CONNECT_OFFSET_STORAGE_REPLICATION_FACTOR=1
CONNECT_STATUS_STORAGE_REPLICATION_FACTOR=1

# --- Sample pipeline ---
SAMPLE_TOPIC=app-events
OPENSEARCH_INDEX=app-events

# --- Host advertised address for external Kafka clients ---
# Set to the RHEL host IP or DNS name reachable by producers outside Podman.
KAFKA_ADVERTISED_HOST=localhost

# OpenSearch Dashboards expects a JSON array string for OPENSEARCH_HOSTS
OPENSEARCH_HOSTS='["http://opensearch:9200"]'
