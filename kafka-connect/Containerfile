# Bake Aiven OpenSearch Sink jars into Confluent Kafka Connect.
# Build context must already contain plugins/aiven-opensearch-connector/*.jar
# (run ../scripts/03-fetch-opensearch-plugin.sh first).
#
#   podman build -t localhost/kafka-connect-opensearch:7.6.1 \
#     -f kafka-connect/Containerfile kafka-connect

ARG CONNECT_VERSION=7.6.1
FROM docker.io/confluentinc/cp-kafka-connect:${CONNECT_VERSION}

ARG CONNECT_PLUGIN_PATH=/usr/share/confluent-hub-components
ENV CONNECT_PLUGIN_PATH="${CONNECT_PLUGIN_PATH}"

USER root

RUN microdnf install -y findutils unzip \
    && microdnf clean all \
    && rm -rf /var/cache/yum /var/cache/dnf \
    && mkdir -p "${CONNECT_PLUGIN_PATH}/aiven-opensearch-connector"

# Prefetched/flattened jars from scripts/03-fetch-opensearch-plugin.sh
COPY plugins/aiven-opensearch-connector/ ${CONNECT_PLUGIN_PATH}/aiven-opensearch-connector/

RUN set -eux; \
    PLUGIN_DIR="${CONNECT_PLUGIN_PATH}/aiven-opensearch-connector"; \
    JAR_COUNT="$(find "${PLUGIN_DIR}" -maxdepth 1 -type f -name '*.jar' | wc -l)"; \
    echo "Baked jar count: ${JAR_COUNT}"; \
    test "${JAR_COUNT}" -ge 1; \
    FOUND=0; \
    for j in "${PLUGIN_DIR}"/*.jar; do \
      if unzip -l "${j}" | grep -q 'io/aiven/kafka/connect/opensearch/OpenSearchSinkConnector.class'; then \
        echo "Found OpenSearchSinkConnector in ${j}"; \
        FOUND=1; \
        break; \
      fi; \
    done; \
    test "${FOUND}" -eq 1; \
    chown -R appuser:appuser "${PLUGIN_DIR}"; \
    chmod -R a+rX "${PLUGIN_DIR}"

USER appuser

LABEL org.opencontainers.image.title="kafka-connect-opensearch" \
      org.opencontainers.image.description="Confluent Kafka Connect with baked Aiven OpenSearch Sink Connector"
